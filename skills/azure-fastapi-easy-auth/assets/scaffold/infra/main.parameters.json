    "resourceAppClientId": {
      "value": "${ENTRA_RESOURCE_APP_ID}"
    },
    "allowedClientApplicationIdsCsv": {
      "value": "${ENTRA_ALLOWED_CLIENT_IDS}"
    }
  }
}
